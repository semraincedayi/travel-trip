@model TravelTrip.Models.Class.Blog
@{
    ViewBag.Title = "UpdateBlog";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Blog Güncelleme Sayfası</h2>
<br />
@using (Html.BeginForm("UpdateBlog", "Admin", FormMethod.Post, new {enctype="multipart/form-data"}))
{
    @Html.LabelFor(x=>x.Id)
    @Html.TextBoxFor(x=>x.Id,new {@class ="form-control",autocomplete="off",@readonly="readonly"})
    <br />
    @Html.LabelFor(x => x.Baslik)
    @Html.TextBoxFor(x => x.Baslik, new { @class = "form-control", autocomplete = "off" })
    <br />
    @Html.LabelFor(x => x.Tarih)
    @Html.TextBoxFor(x => x.Tarih, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    <br />
    @Html.LabelFor(x => x.BlogImage)
    @Html.TextBoxFor(x => x.BlogImage, new { @class = "form-control", autocomplete = "off" })<input type="file" name="FileUpload" class="form-control" accept="image/*" value="" />
    <br />
    @Html.LabelFor(x => x.Aciklama)
    @Html.TextAreaFor(x => x.Aciklama,15,1, new { @class = "form-control", id = "icerikAlani" })
    <br />
    <button class="btn btn-success" type="submit">Blog Güncelle</button>
}

