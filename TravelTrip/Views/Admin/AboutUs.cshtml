@model TravelTrip.Models.Class.Hakkimizda
@{
    ViewBag.Title = "AboutUs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Hakkımızda Güncelleme Sayfası</h2>
<br />
@using (Html.BeginForm("AboutUs", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.LabelFor(x => x.Id)
    @Html.TextBoxFor(x => x.Id, new { @class = "form-control", autocomplete = "off", @readonly = "readonly" })
    <br />
    @Html.LabelFor(x => x.PhotoUrl)
    @Html.TextBoxFor(x => x.PhotoUrl, new { @class = "form-control", autocomplete = "off" })
    <input type="file" name="FileUpload" class="form-control" accept="image/*" value="" />
    <br />
    @Html.LabelFor(x => x.Aciklama)
    @Html.TextAreaFor(x => x.Aciklama, 15, 1, new { @class = "form-control", id = "icerikAlani" })
    <br />
    <button class="btn btn-success" type="submit">Hakkımızda Yazısını Güncelle</button>
}

