@model TravelTrip.Models.Class.Yorumlar
@{
    ViewBag.Title = "UpdateComment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Yorum Güncelleme Sayfası</h2>
<br />
@using (Html.BeginForm("UpdateComment", "Admin", FormMethod.Post))
{
    @Html.LabelFor(x => x.ID)
    @Html.TextBoxFor(x => x.ID, new { @class = "form-control", autocomplete = "off", @readonly = "readonly" })
    <br />
    @Html.LabelFor(x => x.KullaniciAdi )
    @Html.TextBoxFor(x => x.KullaniciAdi, new { @class = "form-control", autocomplete = "off" })
    <br />
    @Html.LabelFor(x => x.Mail)
    @Html.TextBoxFor(x => x.Mail,  new { @class = "form-control", autocomplete="off" })
    <br />
    @Html.LabelFor(x => x.Yorum)
    @Html.TextAreaFor(x => x.Yorum, 15, 1, new { @class = "form-control", id = "icerikAlani" })
    <br />
    <button class="btn btn-success" type="submit">Yorumu Güncelle</button>
}
