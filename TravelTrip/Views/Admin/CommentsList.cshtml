@using TravelTrip.Models.Class
@model List<Yorumlar>
@{
    ViewBag.Title = "CommentsList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Yorum Listesi</h2>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Kullanıcı</th>
        <th>Mail</th>
        <th>Yorum</th>
        <th>Blog</th>
        <th>Yorumu Sil</th>
        <th>Yorumu Güncelle</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.ID</td>
            <td>@x.KullaniciAdi</td>
            <td>@x.Mail</td>
            <td>@x.Yorum</td>
            <td>@x.Blog.Baslik</td>
            <td><a href="/Admin/DeleteComment/@x.ID" class="btn btn-danger">Sil</a>
            <td><a href="/Admin/UpdateComment/@x.ID" class="btn btn-warning">Güncelle</a>
        </tr>
    }

</table>

