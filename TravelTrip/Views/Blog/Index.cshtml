<!DOCTYPE HTML>
<html>
<head>
    <link href="~/web-blog/css/bootstrap.css" rel='stylesheet' type='text/css' />
    <link href="~/web-blog/css/style.css" rel='stylesheet' type='text/css' />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="keywords" content="Personal Blog Responsive web template, Bootstrap Web Templates, Flat Web Templates, Andriod Compatible web template,
	Smartphone Compatible web template, free webdesigns for Nokia, Samsung, LG, SonyErricsson, Motorola web design" />
    <script type="application/x-javascript"> addEventListener("load", function() { setTimeout(hideURLbar, 0); }, false); function hideURLbar(){ window.scrollTo(0,1); } </script>
    <!----webfonts---->
    <link href='http://fonts.googleapis.com/css?family=Oswald:100,400,300,700' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Lato:100,300,400,700,900,300italic' rel='stylesheet' type='text/css'>
    <!----//webfonts---->

</head>
<body>
    <!---header---->
    <div class="header">
        <div class="container">

            <!---start-top-nav---->

            <div class="clearfix"></div>

            <!---//End-top-nav---->
        </div>
    </div>
    <!--/header-->
    <div class="single">
        <div class="container">
            <div class="col-md-8 single-main">
                @foreach (var x in Model.DegerBlog)
                {
                    <div class="single-grid">

                        <img src="@x.BlogImage" alt="" style="margin-bottom: 20px; object-fit: cover; aspect-ratio: 16 / 9; object-position:center" />
                        <a href="/Blog/BlogDetails/@x.Id">@x.Baslik</a>
                        <p>@x.KisaAciklama <a href="/Blog/BlogDetails/@x.Id"> ...Devamını oku</a> </p>
                    </div>
                    <br /><br />
                }


            </div>

            <div class="col-md-4 side-content">
                <div class="recent">
                    <h3>Son Gönderiler</h3>
                    @foreach (var y in Model.Deger3)
                    {
                        <ul>
                            <li><a href="/Blog/BlogDetails/@y.Id">@y.Baslik</a></li>
                        </ul>
                    }
                </div>


                <div class="comments">
                    <h3>Son Yorumlar</h3>
                    @foreach (var z in Model.Deger2)
                    {
                        <ul>
                            <li><a href="/Blog/BlogDetails/@z.BlogId" style="font-weight:bold;">@z.KullaniciAdi: </a><a href="/Blog/BlogDetails/@z.BlogId">@z.Yorum</a></li>
                        </ul>
                    }
                </div>


            </div>


            <div class="clearfix"></div>
            <div style="display: flex; justify-content: center; align-items: center; width: 65%; clear: both; padding: 20px 0;">
                <nav aria-label="...">
                    <ul class="pagination justify-content-center ">
                        @if (ViewBag.CurrentPage == 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Previous</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Blog/Index?page=@(ViewBag.CurrentPage-1)">Previous</a>
                            </li>
                        }
                        @for (int i = 1; i <= @ViewBag.pagenumber; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link">
                                        @i
                                        <span class="sr-only">(current)</span>
                                    </span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="/Blog/Index?page=@i">@i</a></li>
                            }

                        }
                        <li class="page-item">
                            <a class="page-link" href="/Blog/Index?page=@(ViewBag.CurrentPage+1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
            </div>
        </div>
    
</body>
<!---->

</html>


